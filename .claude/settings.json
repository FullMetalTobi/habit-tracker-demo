{
  "hooks": {
    "SubagentStop": [
      { "hooks": [
        { "type": "command", "timeout": 180,
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gates-on-stop.sh" },
        { "type": "command", "timeout": 60,
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/file-guard.sh" }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "timeout": 180,
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gates-on-stop.sh" },
        { "type": "command", "timeout": 60,
          "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/file-guard.sh" }
      ] }
    ]
  }
}
