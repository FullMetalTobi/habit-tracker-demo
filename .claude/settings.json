{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/schema-guard.sh",
            "timeout": 120,
            "statusMessage": "schema-guard: checking schema files"
          }
        ]
      }
    ]
  }
}
