#!/bin/sh
# Team gate for every commit (human or any agent). Enable once per clone:
#   git config core.hooksPath .githooks
log="$(git rev-parse --git-dir)/hook.log"
echo "$(date +%T) pre-commit start" >> "$log"

# Guard: no newly added skipped or focused tests (ATDD scaffolds: set
# ALLOW_SKIP=1 once, when committing them before the build)
if [ -z "$ALLOW_SKIP" ] && git diff --cached -U0 -- tests e2e \
  | grep -nE '^\+.*\b(test|it|describe)\.(skip|only)\(' >&2; then
  echo "pre-commit: new test.skip/.only in staged tests (see lines above)" >&2
  echo "$(date +%T) pre-commit FAIL skip" >> "$log"; exit 1
fi

# Guard (Ü6): ADRs that exist on the main branch stay as they are; a new
# decision is a new ADR. An ADR added on this branch (not merged) may change.
# Deliberate change (e.g. status "Superseded by"): ADR_OK=1 git commit ...
# Main branch: origin/HEAD (main, master or develop), else origin/main.
# Missing origin/HEAD: git remote set-head origin --auto
main="$ADR_MAIN"
[ -n "$main" ] || main="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null)" \
  || main=origin/main
base="$(git merge-base HEAD "$main" 2>/dev/null)" || { base=HEAD; main=HEAD; }
bad=""
for f in $(git diff --cached --name-only --no-renames --diff-filter=MD \
  -- 'docs/adr/[0-9][0-9][0-9][0-9]-*'); do
  git cat-file -e "$base:$f" 2>/dev/null && bad="$bad $f"
done
if [ -z "$ADR_OK" ] && [ -n "$bad" ]; then
  echo "pre-commit: ADR from $main changed:$bad" >&2
  echo "pre-commit: write a new ADR instead (or ADR_OK=1, deliberately)" >&2
  echo "$(date +%T) pre-commit FAIL adr" >> "$log"; exit 1
fi

# Gate: lint and unit tests (~20 s)
out="$(git rev-parse --git-dir)/pre-commit.out"
if ! npm run --silent lint >"$out" 2>&1 || ! npm test --silent >>"$out" 2>&1
then
  tail -n 30 "$out" >&2; echo "pre-commit: lint or unit tests failed" >&2
  echo "$(date +%T) pre-commit FAIL gate" >> "$log"; exit 1
fi
echo "$(date +%T) pre-commit ok" >> "$log"
